<Window x:Class="YtmDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTM Dock 설정"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="True"
        Background="#1E1E1E" Foreground="#EEE" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <!-- 핫키 입력칸: 클릭 후 조합을 누르면 기록된다 -->
        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FF3B30"/>
                    <Setter Property="Background" Value="#332222"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClearBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="이 핫키 없애기"/>
        </Style>
        <Style x:Key="MainBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="BorderBrush" Value="#555"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="전역 핫키" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="칸을 클릭한 뒤 원하는 조합을 누르세요. 다른 창에 있을 때도 동작합니다." Foreground="#999" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="⏮ 이전 곡"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="BoxPrev"  Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <Button    Grid.Row="0" Grid.Column="2" Content="✕" Style="{StaticResource ClearBtn}" Tag="{Binding ElementName=BoxPrev}" Click="Clear_Click"/>

            <TextBlock Grid.Row="1" Text="⏭ 다음 곡"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="BoxNext"  Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <Button    Grid.Row="1" Grid.Column="2" Content="✕" Style="{StaticResource ClearBtn}" Tag="{Binding ElementName=BoxNext}" Click="Clear_Click"/>

            <TextBlock Grid.Row="2" Text="⏯ 재생 / 정지"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="BoxPlay"  Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <Button    Grid.Row="2" Grid.Column="2" Content="✕" Style="{StaticResource ClearBtn}" Tag="{Binding ElementName=BoxPlay}" Click="Clear_Click"/>

            <TextBlock Grid.Row="3" Text="👁 보이기 / 숨기기"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="BoxToggle" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <Button    Grid.Row="3" Grid.Column="2" Content="✕" Style="{StaticResource ClearBtn}" Tag="{Binding ElementName=BoxToggle}" Click="Clear_Click"/>

            <TextBlock Grid.Row="4" Text="🔊 볼륨 올리기"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="BoxVolUp" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <Button    Grid.Row="4" Grid.Column="2" Content="✕" Style="{StaticResource ClearBtn}" Tag="{Binding ElementName=BoxVolUp}" Click="Clear_Click"/>

            <TextBlock Grid.Row="5" Text="🔉 볼륨 내리기"/>
            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="BoxVolDown" Style="{StaticResource HotkeyBox}" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <Button    Grid.Row="5" Grid.Column="2" Content="✕" Style="{StaticResource ClearBtn}" Tag="{Binding ElementName=BoxVolDown}" Click="Clear_Click"/>
        </Grid>

        <TextBlock x:Name="Hint" Foreground="#E0A030" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <TextBlock Text="팁: 키보드에 미디어 키가 있으면 그 키를 그대로 눌러 등록할 수 있어요. 단, 다른 음악·영상 앱은 그 키를 받지 못하게 됩니다." Foreground="#777" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="기본값" Style="{StaticResource MainBtn}" Click="Defaults_Click"/>
            <Button Content="취소"   Style="{StaticResource MainBtn}" IsCancel="True"/>
            <Button Content="저장"   Style="{StaticResource MainBtn}" IsDefault="True" Click="Save_Click" Background="#B3261E"/>
        </StackPanel>
    </StackPanel>
</Window>
