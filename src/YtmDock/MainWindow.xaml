<Window x:Class="YtmDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="YTM Dock"
        Width="440" Height="64"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="False"
        Background="#1F1F1F"
        ShowInTaskbar="False"
        ShowActivated="False">
    <!--
        크기는 코드(MiniW/MiniH, FullW/FullH)가 관리한다.
        미니 모드에서는 WebView2 를 창보다 넓게(VirtualW) 두어 유튜브 뮤직이 '컴팩트 바'로 바뀌지 않게 한다.
        창 밖으로 나간 부분은 그냥 잘린다.

        AllowsTransparency="False" 는 의도적. WebView2 는 자식 HWND 라 투명 창 위에서 깨진다(에어스페이스).
        ShowInTaskbar="False": 작업 표시줄 대신 트레이 아이콘으로 다룬다 (4단계).
    -->
    <Grid ClipToBounds="True">
        <wv2:WebView2 x:Name="Web" HorizontalAlignment="Left" VerticalAlignment="Stretch" />
    </Grid>
</Window>
