<Window x:Class="YtmDock.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTM Dock 알람"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="True"
        Background="#1E1E1E" Foreground="#EEE" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="CaretBrush" Value="#FFF"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,12,0"/>
        </Style>
        <!-- 요일 알약: 눌린 요일은 빨강 -->
        <Style x:Key="DayToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="14" Background="#2A2A2A" BorderBrush="#444" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B3261E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B3261E"/>
                                <Setter Property="Foreground" Value="#FFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ClearBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="이 알람 지우기"/>
        </Style>
        <Style x:Key="MainBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="BorderBrush" Value="#555"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <DockPanel>
            <CheckBox x:Name="ChkEnabled" DockPanel.Dock="Right" Content="알람 사용"/>
            <TextBlock Text="알람 자동 재생" FontSize="15" FontWeight="SemiBold"/>
        </DockPanel>
        <TextBlock Foreground="#999" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"
                   Text="정한 시각이 되면 플레이리스트를 첫 곡부터 재생합니다. 그 시각에 PC 가 꺼져 있거나 절전 중이었다면, 켜거나 깨우는 순간 대신 울립니다."/>

        <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="List"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Text="아직 알람이 없어요. 아래 버튼으로 추가하세요." Foreground="#777" Margin="0,4,0,8"/>

        <Button Content="＋ 알람 추가" Style="{StaticResource SmallBtn}" Margin="0,4,0,0" HorizontalAlignment="Left" Click="Add_Click"/>

        <Border Height="1" Background="#333" Margin="0,16,0,12"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="놓친 알람은 알람 시각부터"/>
            <TextBox x:Name="BoxCatchUp" Width="48" Margin="6,0" HorizontalContentAlignment="Center"/>
            <TextBlock Text="분 안에 켜거나 깨우면 울리기"/>
        </StackPanel>
        <CheckBox x:Name="ChkSkip"  Content="알람 시각에 이미 음악이 나오고 있으면 끊지 않기" Margin="0,4"/>
        <CheckBox x:Name="ChkDefer" Content="화면이 잠겨 있으면 잠금을 풀 때 울리기" Margin="0,4"/>

        <TextBlock x:Name="Hint" Foreground="#E0A030" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="취소" Style="{StaticResource MainBtn}" IsCancel="True"/>
            <Button Content="저장" Style="{StaticResource MainBtn}" IsDefault="True" Click="Save_Click" Background="#B3261E"/>
        </StackPanel>
    </StackPanel>
</Window>
